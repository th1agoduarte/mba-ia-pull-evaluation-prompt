# Copie para `.env` na raiz deste desafio: cp .env.example .env
# As chaves e os modelos vêm do .env raiz de technical-challenges/ (padrão: Google).
# Tudo é lido por python-dotenv em src/utils.py; o .env é gitignored.

# --------------------------------------------------------------------------- #
# LangSmith                                                                    #
# --------------------------------------------------------------------------- #

# Liga o tracing: cada chamada ao LLM vira um trace no LangSmith. É o principal
# instrumento de debug das iterações e o entregável exige tracing de >= 3 exemplos.
LANGSMITH_TRACING=true

# Endpoint da API do LangSmith (troque só se usar a região EU ou self-hosted).
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Autentica o langsmith.Client em pull, push, criação do dataset e experimentos.
# Gere em https://smith.langchain.com > Settings > API Keys.
LANGSMITH_API_KEY=

# Projeto de tracing. Não deixe em branco: src/evaluate.py usa este valor para
# nomear o dataset de avaliação ({LANGSMITH_PROJECT}-eval). Se mudar, um dataset
# novo é criado e o histórico de experimentos fica no antigo.
LANGSMITH_PROJECT=mba-ia-pull-evaluation-prompt

# Handle público do LangSmith Hub. Vira o prefixo do prompt publicado
# ({USERNAME_LANGSMITH_HUB}/bug_to_user_story_v2) e é de onde evaluate.py puxa o prompt.
#
# "evaluation-prompt" é o handle do autor deste repositório. O prompt
# evaluation-prompt/bug_to_user_story_v2 é PÚBLICO, então quem for avaliar pode
# manter este valor e rodar `make eval` com a própria LANGSMITH_API_KEY (sem push).
#
# Para publicar o seu próprio prompt (`make push`), troque pelo SEU handle. Ele só
# existe depois que você torna um prompt público pela primeira vez:
#   LangSmith > Prompts > abra um prompt > "⋯" ao lado de Playground > Make Public
#   > "Choose your public handle". O handle é DEFINITIVO depois de confirmado.
USERNAME_LANGSMITH_HUB=evaluation-prompt

# --------------------------------------------------------------------------- #
# Provider e modelos                                                           #
# --------------------------------------------------------------------------- #

# Qual integração LangChain o src/utils.py:get_llm instancia (o arquivo original
# aceita só google e openai, e o enunciado proíbe alterá-lo):
#   google -> ChatGoogleGenerativeAI, direto na API do Gemini (PADRÃO, sem custo)
#   openai -> ChatOpenAI, direto na OpenAI ou, com OPENAI_BASE_URL, via gateway
# Anthropic e AWS Bedrock passam pelo gateway LiteLLM (docker-compose.yml).
# Não edite à mão: use `make <alvo> PROVIDER=anthropic|aws|openai|gateway`.
# O Makefile sobrescreve LLM_PROVIDER, LLM_MODEL, EVAL_MODEL, OPENAI_BASE_URL
# e OPENAI_API_KEY só naquela execução, sem mudar este arquivo.
LLM_PROVIDER=google

# Modelo que transforma o bug report em user story (o "target" do experimento).
# Prefira um modelo que aceite temperature=0, para a avaliação ser reproduzível.
LLM_MODEL=gemini-3.5-flash-lite

# Modelo juiz das métricas F1/Clarity/Precision (src/metrics.py). Um modelo mais
# capaz que o LLM_MODEL tende a dar notas mais estáveis entre iterações.
EVAL_MODEL=gemini-3.5-flash

# Presets por provider, usados por `make ... PROVIDER=<p>`. Consulte a doc de
# cada provider: os nomes mudam e alguns modelos são descontinuados.
GOOGLE_LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_EVAL_MODEL=gemini-3.5-flash
OPENAI_LLM_MODEL=
OPENAI_EVAL_MODEL=
ANTHROPIC_LLM_MODEL=claude-haiku-5-5
ANTHROPIC_EVAL_MODEL=claude-sonnet-5-5
# Model ID do Bedrock (ex.: um inference profile "us.anthropic...."), sem o prefixo bedrock/
AWS_LLM_MODEL=
AWS_EVAL_MODEL=

# --------------------------------------------------------------------------- #
# Gateway LiteLLM (Docker) — só para Anthropic / AWS Bedrock                   #
# --------------------------------------------------------------------------- #

# Chave que o projeto apresenta ao gateway; o Makefile a coloca em
# OPENAI_API_KEY quando PROVIDER aponta para o gateway. Precisa começar com "sk-".
# `make env` gera uma aleatória.
LITELLM_MASTER_KEY=

# Porta local do gateway (http://localhost:4000). Mude se a 4000 estiver ocupada.
GATEWAY_PORT=4000

# --------------------------------------------------------------------------- #
# Credenciais por provider (preencha só a do LLM_PROVIDER escolhido)           #
# --------------------------------------------------------------------------- #

# Google Gemini — https://aistudio.google.com/apikey
# Modelos: https://ai.google.dev/gemini-api/docs/models
GOOGLE_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
# Modelos: https://platform.openai.com/docs/models
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
# Modelos: https://docs.anthropic.com/en/docs/about-claude/models
ANTHROPIC_API_KEY=

# AWS Bedrock — credenciais IAM com acesso ao modelo liberado em
# Bedrock > Model access na região abaixo. Alternativa: AWS_PROFILE apontando
# para ~/.aws/credentials (aí deixe as chaves vazias).
# Model IDs: https://docs.aws.amazon.com/bedrock/latest/userguide/models-supported.html
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Só para credenciais temporárias (SSO/STS):
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
AWS_REGION=us-east-1
